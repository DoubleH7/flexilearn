# Copy to `.env` (gitignored) and fill in. Loaded by flexilearn/entry.py via
# python-dotenv at startup, so these land in the process environment before the
# first HuggingFace download.

# HuggingFace Hub token — raises download rate limits and is required for gated
# repos. huggingface_hub reads either of these names.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
